#!/usr/bin/env python3

import pyghidra
from pyghidra.api import open_project, program_context
import os
import sys
import json
from pathlib import Path

# Attempt to locate Ghidra if GHIDRA_INSTALL_DIR is not set
if 'GHIDRA_INSTALL_DIR' not in os.environ:
    # Common paths or the one we found
    possible_paths = [
        '/snap/ghidra/current/ghidra_12.0_PUBLIC',
        '/opt/ghidra',
        os.path.expanduser('~/ghidra')
    ]
    for path in possible_paths:
        if os.path.isdir(path):
            os.environ['GHIDRA_INSTALL_DIR'] = path
            break

def get_less_than_n_tags(project_location, project_name, program_path, n):
    """
    Opens a Ghidra project and lists all functions that have less than n tags.
    """
    try:
        # Initialize Ghidra
        pyghidra.start()
    except Exception as e:
        print(f"Error starting Ghidra: {e}")
        print("Please ensure GHIDRA_INSTALL_DIR is set correctly.")
        return

    try:
        # Open the existing project
        with open_project(project_location, project_name, create=False) as project:
            # Open the specific program context
            with program_context(project, program_path) as program:
                print(f"Successfully opened: {program.getName()}")
                print(f"{'Address':<16} | {'Tags':<4} | {'Function Name'}")
                print("-" * 50)
                
                fm = program.getFunctionManager()
                # Iterate through all functions in address order
                functions = fm.getFunctions(True)
                
                count = 0
                for func in functions:
                    tags = func.getTags()
                    num_tags = len(tags)
                    if num_tags < n:
                        print(f"{str(func.getEntryPoint()):<16} | {num_tags:<4} | {func.getName()}")
                        count += 1
                
                print("-" * 50)
                print(f"Total functions with less than {n} tags: {count}")
    except Exception as e:
        print(f"An error occurred: {e}")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python3 get_less_than_n_tags.py <n> [program_location]")
        print("Example: python3 get_less_than_n_tags.py 2")
        sys.exit(1)
        
    try:
        n = int(sys.argv[1])
    except ValueError:
        print("Error: <n> must be an integer.")
        sys.exit(1)

    project_aipiler = Path(__file__).parent.parent / "project.aipiler"
    with open(project_aipiler) as f:
        data = json.loads(f.read())


    PROJ_LOC = data["project_location"]
    PROJ_NAME = data["project_name"]
    PROG_PATH = data["program_location"]
    
    # Allow command line overrides
    if len(sys.argv) > 2:
        PROG_PATH = sys.argv[2]
    
    get_less_than_n_tags(PROJ_LOC, PROJ_NAME, PROG_PATH, n)
