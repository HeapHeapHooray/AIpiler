#!/usr/bin/env python3

import pyghidra
import os
import sys
import time
import json
from pathlib import Path

# Attempt to locate Ghidra if GHIDRA_INSTALL_DIR is not set
if 'GHIDRA_INSTALL_DIR' not in os.environ:
    possible_paths = [
        '/snap/ghidra/current/ghidra_12.0_PUBLIC',
        '/opt/ghidra',
        os.path.expanduser('~/ghidra')
    ]
    for path in possible_paths:
        if os.path.isdir(path):
            os.environ['GHIDRA_INSTALL_DIR'] = path
            break

def rename_function(project_location, project_name, program_path, function_name_or_address, new_name):
    """
    Opens a Ghidra project, renames a specific function, and adds the 'RENAMED' tag.
    """
    try:
        pyghidra.start()
    except Exception as e:
        print(f"Error starting Ghidra: {e}")
        return

    from pyghidra.api import open_project, program_context
    from ghidra.program.model.symbol import SourceType

    while True:
        try:
            with open_project(project_location, project_name, create=False) as project:
                with program_context(project, program_path) as program:
                    fm = program.getFunctionManager()
                    target_func = None

                    # Try to parse as an address first
                    try:
                        addr = program.getAddressFactory().getAddress(function_name_or_address)
                        if addr is not None:
                             target_func = fm.getFunctionContaining(addr)
                    except Exception:
                        pass
                    
                    # If it wasn't found by address, search by name
                    if target_func is None:
                        functions = fm.getFunctions(True)
                        for func in functions:
                            if func.getName() == function_name_or_address:
                                target_func = func
                                break
                                
                    if target_func is None:
                        print(f"Error: Function '{function_name_or_address}' not found.")
                        return

                    old_name = target_func.getName()
                    print(f"Renaming function '{old_name}' at {target_func.getEntryPoint()} to '{new_name}' and adding 'RENAMED' tag.")
                    
                    # In Ghidra, all modifications must be in a transaction
                    tx_id = program.startTransaction(f"Rename function {old_name} to {new_name}")
                    success = False
                    try:
                        target_func.setName(new_name, SourceType.USER_DEFINED)
                        target_func.addTag("RENAMED")
                        success = True
                    except Exception as tx_err:
                        print(f"Failed to rename function or add tag: {tx_err}")
                    finally:
                        program.endTransaction(tx_id, success)
                    
                    if success:
                        print(f"Successfully renamed function to '{new_name}' and added tag 'RENAMED'.")
                        # Save the program to persist changes to the project
                        program.save("Renamed function via AIpiler tool", None)
            break
        except Exception as e:
            if "lock" in str(e).lower():
                print("Failed to acquire project lock, retrying in 2s...", file=sys.stderr)
                time.sleep(2)
            else:
                print(f"An error occurred: {e}")
                break

if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("Usage: aipiler_rename_function <function_name_or_address> <new_name> [program_location]")
        sys.exit(1)

    func_target = sys.argv[1]
    new_name = sys.argv[2]

    project_aipiler = Path(__file__).parent.parent / "project.aipiler"
    if not project_aipiler.exists():
        print(f"Error: {project_aipiler} not found.")
        sys.exit(1)

    with open(project_aipiler) as f:
        data = json.loads(f.read())

    PROJ_LOC = data["project_location"]
    PROJ_NAME = data["project_name"]
    PROG_PATH = data["program_location"]
    
    # Allow command line overrides for program path if provided as 3rd arg
    if len(sys.argv) > 3:
        PROG_PATH = sys.argv[3]
    
    rename_function(PROJ_LOC, PROJ_NAME, PROG_PATH, func_target, new_name)
